@startuml DiffRes

'Classes

class DiffRes {
    - changes : list[BasicChange]
    + getAdded() : list[BasicChange]
    + getRemoved() : list[BasicChange]
    + getModified() : list[BasicChange]
    + onlyAdded() : Boolean
}

class BasicChange {
    - reference : String
}

class ComponentMoved {
    - old_pos : String
    - new_pos : String
}

class ComponentRemoved {
}

class ComponentAdded {
}

class ComponentValueChanged {
    - old_value : String
    - new_value : String
}

'Association
DiffRes "1" --> "*" BasicChange : contains

'Inheritance
BasicChange <|-- ComponentMoved
BasicChange <|-- ComponentRemoved
BasicChange <|-- ComponentAdded
BasicChange <|-- ComponentValueChanged

@enduml