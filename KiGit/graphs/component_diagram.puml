@startuml "Component Diagram KiGit"
'layout optimization
'spacing between layer
skinparam ranksep 50
'spacing between elements on same layer
skinparam nodesep 50
'spacing between each arrow/liens
skinparam linetype orhto 
'alternative polyline


title KiGit - Component Diagram

'left to right direction

actor "User (Terminal)" as user

package "KiGit" {
	component [main.py] as main <<CLI Entrypoint>> {
		note top of main
			chooses command:
			- if 'status': calls commands.py
			- if 'quick-status' : calls commands.py
			- if 'diff': calls commands.py -> diff_parser.py
		end note
	}
	component [commands.py] as commands <<Git Adapter>>
	component [diff_parser.py] as parser <<Parser>>

	package "Data Models" {
		component [diffres.py] as diffres <<Data Class>>
		component [basicchange.py] as basicchange <<Data Class>>
	}

	component [DiffResRenderer.py] as renderer <<Output Generator>>

	component [mkdocs] as docs <<Documentation Framework>>
}

package "System / Environment" {
	[Git Repository] as gitrepo
	() "GitPython Library     " as gitpy
}

user --> main : starts command (e.g. kigit diff)

main --> commands : get diff()
commands --> gitpy : retrieves rawdata
gitpy -- gitrepo

main --> parser : ""only if 'diff'""\nhands over DiffIndex

parser ..> diffres : created and filled
parser ..> basicchange : used for DiffRes

parser ..> main : returns ready DiffRes object(s)

main --> renderer : render()
renderer --> user : show()

user --> docs : serve()
docs --> user : show_docs()

@enduml